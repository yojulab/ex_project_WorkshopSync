{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Server: Express (Port 30015)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "API Server: Node Debugger (Port 30015)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/apps/api/dist/index.js",
      "preLaunchTask": "build:api",
      "env": {
        "PORT": "30015",
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Mobile App: React PWA (Port 30016)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Admin Portal: React Web (Port 30017)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Chrome: 참석자 전용 앱 (Port 30016)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:30016",
      "webRoot": "${workspaceFolder}/apps/mobile"
    },
    {
      "name": "Chrome: 관리자 웹 포털 (Port 30017)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:30017",
      "webRoot": "${workspaceFolder}/apps/admin"
    },
    {
      "name": "(선택) Chrome 디버거 연결 (Attach only - Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack: 3개 서버 동시 실행 (:30015, :30016, :30017)",
      "configurations": [
        "API Server: Express (Port 30015)",
        "Mobile App: React PWA (Port 30016)",
        "Admin Portal: React Web (Port 30017)"
      ]
    }
  ]
}
