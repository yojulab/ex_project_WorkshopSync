{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": [
        "API (Port 30015)",
        "Mobile App Server (Port 30016)",
        "Admin Web Server (Port 30017)"
      ]
    },
    {
      "name": "Frontend Both (Mobile + Admin)",
      "configurations": [
        "Mobile App Server (Port 30016)",
        "Admin Web Server (Port 30017)"
      ]
    }
  ],
  "configurations": [
    {
      "name": "Full Stack (API Debug + Auto Frontends)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/dist/index.js",
      "preLaunchTask": "pre-launch-fullstack",
      "cwd": "${workspaceFolder}/apps/api",
      "sourceMaps": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "WorkshopSync REST API 서버가 성공적으로 시작되었습니다",
        "uriFormat": "http://localhost:30016",
        "action": "openExternally"
      },
      "env": {
        "NODE_ENV": "development",
        "PORT": "30015",
        "API_PORT": "30015"
      },
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/packages/shared/dist/**/*.js"
      ]
    },
    {
      "name": "API (Port 30015)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/dist/index.js",
      "preLaunchTask": "build-api",
      "cwd": "${workspaceFolder}/apps/api",
      "sourceMaps": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "WorkshopSync REST API 서버가 성공적으로 시작되었습니다",
        "uriFormat": "http://localhost:30016",
        "action": "openExternally"
      },
      "env": {
        "NODE_ENV": "development",
        "PORT": "30015",
        "API_PORT": "30015"
      },
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/packages/shared/dist/**/*.js"
      ]
    },
    {
      "name": "Mobile App Server (Port 30016)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Admin Web Server (Port 30017)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to API (Port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/apps/api",
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/packages/shared/dist/**/*.js"
      ]
    }
  ]
}
