{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Launch API (Port 30015)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/dist/index.js",
      "preLaunchTask": "build-api",
      "cwd": "${workspaceFolder}/apps/api",
      "sourceMaps": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "PORT": "30015",
        "API_PORT": "30015"
      },
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/packages/shared/dist/**/*.js"
      ]
    },
    {
      "name": "🔗 Attach to API (Port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/apps/api",
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js",
        "${workspaceFolder}/packages/shared/dist/**/*.js"
      ]
    }
  ]
}
