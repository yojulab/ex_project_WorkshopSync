        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "server:stop:all",
      "type": "shell",
      "command": "./run_port.sh stop all",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "server:status",
      "type": "shell",
      "command": "./run_port.sh status",
      "problemMatcher": [],
