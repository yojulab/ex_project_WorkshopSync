{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-all",
      "type": "shell",
      "command": "./compile.sh all",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-shared",
      "type": "shell",
      "command": "npm run build --workspace=@workshopsync/shared",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-api",
      "type": "shell",
      "command": "npm run build --workspace=@workshopsync/shared && npm run build --workspace=workshopsync-api",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-mobile",
      "type": "shell",
      "command": "npm run build --workspace=workshopsync-mobile",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-admin",
      "type": "shell",
      "command": "npm run build --workspace=workshopsync-admin",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "start-all-dev",
      "type": "shell",
      "command": "./run_port.sh dev all",
      "problemMatcher": []
    },
    {
      "label": "stop-all",
      "type": "shell",
      "command": "./run_port.sh stop all",
      "problemMatcher": []
    },
    {
      "label": "status",
      "type": "shell",
      "command": "./run_port.sh status",
      "problemMatcher": []
    },
    {
      "label": "start-frontend-servers",
      "type": "shell",
      "command": "./run_port.sh dev 30016 && ./run_port.sh dev 30017",
      "problemMatcher": []
    },
    {
      "label": "pre-launch-fullstack",
      "dependsOn": ["build-api", "start-frontend-servers"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
